# ============ BIMIFINANCE ENV EXAMPLE ============
# 1. Скопіюй цей шаблон у реальний .env (який НЕ комітиться в git).
# 2. Заповни реальні значення.

# --- База даних ---
POSTGRES_DB=bimi
POSTGRES_USER=bimi
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://bimi:change-me@postgres:5432/bimi

# --- Phase 1: Security (ОБОВ'ЯЗКОВО, інакше бекенд не стартує) ---
# Токен Telegram-бота (ТАКИЙ САМИЙ, як BOT_TOKEN у BimiPal) — для валідації initData Mini App.
BOT_TOKEN=123456789:AA_HERE_YOUR_TG_BOT_TOKEN

# Секрет JWT. Генерація: openssl rand -hex 32
JWT_SECRET=hex-here-64-chars

# Ключ Fernet. Генерація:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=base64-fernet-key-here

# Спільний внутрішній ключ бота (ТАКИЙ САМИЙ, як BOT_API_KEY у BimiPal). Генерація: openssl rand -hex 32
BOT_API_KEY=hex-here-64-chars

# Дозволені CORS-origin через кому (URL Mini App):
CORS_ORIGINS=https://bimiapp.vshevchuk.pp.ua

# --- Опціонально ---
ACCESS_TOKEN_EXPIRE_HOURS=1
INIT_DATA_MAX_AGE=86400
